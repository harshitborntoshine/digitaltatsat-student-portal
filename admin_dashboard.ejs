<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel — Student Info & Feedback Management | FeedbackHub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container">
    <% if (success) { %>
      <div class="alert alert-success">
        <span class="alert-icon">✓</span> <%= success %>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error">
        <span class="alert-icon">⚠️</span> <%= error %>
      </div>
    <% } %>

    <!-- Admin Welcome Header -->
    <div class="page-heading">
      <div>
        <div class="eyebrow">🛡️ ADMIN PANEL</div>
        <h1>Student Info & Feedback Management <span>✦</span></h1>
        <p>View student details, read their feedback, and mark submissions as Approved or Rejected.</p>
      </div>
      <div class="heading-actions flex-gap">
        <a href="/admin/export/csv" class="btn btn-outline" title="Export Excel / CSV">📥 Export CSV</a>
        <a href="/admin/export/report" class="btn btn-outline" target="_blank" title="Print PDF Report">🖨️ PDF Report</a>
      </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="stats-grid admin-stats-grid">
      <div class="stat-card total">
        <div class="stat-icon-wrap">📋</div>
        <div class="stat-info">
          <div class="label">Total Feedback</div>
          <div class="value"><%= stats.total %></div>
        </div>
      </div>
      <div class="stat-card pending">
        <div class="stat-icon-wrap">⏳</div>
        <div class="stat-info">
          <div class="label">Pending Review</div>
          <div class="value"><%= stats.pending %></div>
        </div>
      </div>
      <div class="stat-card accepted">
        <div class="stat-icon-wrap">✅</div>
        <div class="stat-info">
          <div class="label">Approved</div>
          <div class="value"><%= stats.accepted %></div>
        </div>
      </div>
      <div class="stat-card rejected">
        <div class="stat-icon-wrap">❌</div>
        <div class="stat-info">
          <div class="label">Rejected</div>
          <div class="value"><%= stats.rejected %></div>
        </div>
      </div>
      <div class="stat-card students-stat">
        <div class="stat-icon-wrap">🎓</div>
        <div class="stat-info">
          <div class="label">Registered Students</div>
          <div class="value"><%= totalStudents %></div>
        </div>
      </div>
      <div class="stat-card avg-rating">
        <div class="stat-icon-wrap">⭐</div>
        <div class="stat-info">
          <div class="label">Campus Rating</div>
          <div class="value"><%= stats.avgRating %><small>/5</small></div>
        </div>
      </div>
    </div>

    <div class="section-title">
      <h2>Campus Intelligence</h2>
      <span class="live-dot">● Live feedback analytics</span>
    </div>

    <div class="analytics-grid admin-analytics-grid">
      <div class="panel chart-panel">
        <div class="panel-heading">
          <div>
            <h2>Resolution Pipeline</h2>
            <p>Track every submission from intake to decision</p>
          </div>
          <span class="insight-pill"><%= stats.approvalRate %>% approved</span>
        </div>
        <div class="chart-box"><canvas id="adminStatusChart"></canvas></div>
      </div>
      <div class="panel chart-panel">
        <div class="panel-heading">
          <div>
            <h2>Feedback by Category</h2>
            <p>Where students need the most support</p>
          </div>
        </div>
        <div class="chart-box"><canvas id="adminCategoryChart"></canvas></div>
      </div>
    </div>

    <!-- ====== SECTION 1: STUDENT DIRECTORY ====== -->
    <div class="section-title">
      <h2>👥 Registered Students Directory</h2>
      <span class="live-dot">● View student personal info</span>
    </div>

    <div class="panel" style="margin-bottom:28px;">
      <div class="panel-heading flex-between flex-wrap gap-12">
        <div>
          <h2>Student Records</h2>
          <p>Click "View Details" to see the student's profile and all their feedback submissions</p>
        </div>
        <div class="search-wrap">
          <input type="text" id="studentSearchInput" placeholder="🔍 Search name, email, roll no, course..." onkeyup="filterStudentDirectory()" class="student-search-bar" />
        </div>
      </div>

      <% if (students.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">👥</div>
          <h3>No students registered yet.</h3>
        </div>
      <% } else { %>
        <div class="table-scroll">
          <table class="students-table" id="studentsTable">
            <thead>
              <tr>
                <th>Student Profile</th>
                <th>Email Address</th>
                <th>Roll Number</th>
                <th>Course / Dept</th>
                <th>Feedback Activity</th>
                <th>Avg Rating</th>
                <th>Joined Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(s => { %>
                <tr class="student-row" data-search="<%= (s.name + ' ' + s.email + ' ' + (s.roll_number || '') + ' ' + (s.course || '')).toLowerCase() %>">
                  <td>
                    <div class="table-student-cell">
                      <span class="table-avatar"><%= s.name.charAt(0).toUpperCase() %></span>
                      <div>
                        <strong><%= s.name %></strong>
                        <span class="role-micro-badge">Student</span>
                      </div>
                    </div>
                  </td>
                  <td class="muted-cell"><%= s.email %></td>
                  <td>
                    <span class="roll-pill"><%= s.roll_number || 'N/A' %></span>
                  </td>
                  <td><%= s.course || 'Not specified' %></td>
                  <td>
                    <div class="activity-summary-pill">
                      <span class="fb-count-badge" title="Total Feedback"><%= s.feedback_count %> Total</span>
                      <% if (s.feedback_count > 0) { %>
                        <span class="fb-sub-badge accepted" title="Accepted">✓ <%= s.accepted_count %></span>
                        <span class="fb-sub-badge pending" title="Pending">⏳ <%= s.pending_count %></span>
                        <span class="fb-sub-badge rejected" title="Rejected">✗ <%= s.rejected_count %></span>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <% if (s.avg_rating) { %>
                      <strong style="color:#7c3aed;"><%= Number(s.avg_rating).toFixed(1) %> ★</strong>
                    <% } else { %>
                      <span class="muted-cell">—</span>
                    <% } %>
                  </td>
                  <td class="muted-cell"><%= new Date(s.created_at).toLocaleDateString() %></td>
                  <td>
                    <button type="button" class="btn btn-primary btn-sm view-profile-btn" onclick="openStudentModal(<%= s.id %>)">
                      👁 View Details
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- ====== SECTION 2: ALL FEEDBACK — ACCEPT / REJECT ====== -->
    <div class="section-title">
      <h2>📑 All Student Feedback — Review & Action</h2>
      <span class="live-dot">● Accept or Reject feedback submissions</span>
    </div>

    <div class="panel feedback-management-panel">
      <div class="panel-heading flex-between flex-wrap gap-12">
        <div>
          <h2>Feedback Submissions</h2>
          <p>Review feedback, add admin remarks, and mark as Approved or Rejected</p>
        </div>

        <div class="admin-filter-controls">
          <input type="text" id="adminSearchInput" placeholder="🔍 Search teacher, subject, student..." onkeyup="filterAdminFeedback()" class="admin-search-input" />
          
          <select id="adminCatSelect" onchange="applyCategoryFilter(this.value)" class="custom-select-sm">
            <option value="All" <%= categoryFilter === 'All' ? 'selected' : '' %>>All Categories</option>
            <% categoryStats.forEach(cat => { %>
              <option value="<%= cat.label %>" <%= categoryFilter === cat.label ? 'selected' : '' %>><%= cat.label %> (<%= cat.value %>)</option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- Filter Status Tabs -->
      <div class="filter-tabs">
        <a href="/admin/dashboard?status=All&category=<%= categoryFilter %>" class="<%= filter === 'All' ? 'active' : '' %>">All Feedbacks (<%= stats.total %>)</a>
        <a href="/admin/dashboard?status=Pending&category=<%= categoryFilter %>" class="<%= filter === 'Pending' ? 'active' : '' %>">Pending (<%= stats.pending %>)</a>
        <a href="/admin/dashboard?status=Accepted&category=<%= categoryFilter %>" class="<%= filter === 'Accepted' ? 'active' : '' %>">Approved (<%= stats.accepted %>)</a>
        <a href="/admin/dashboard?status=Rejected&category=<%= categoryFilter %>" class="<%= filter === 'Rejected' ? 'active' : '' %>">Rejected (<%= stats.rejected %>)</a>
      </div>

      <% if (feedbacks.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">🔍</div>
          <h3>No feedback found matching the selected filter.</h3>
        </div>
      <% } else { %>
        <div class="feedback-cards-wrapper" id="adminFeedbackList">
          <% feedbacks.forEach(fb => { %>
            <div class="feedback-card admin-fb-card" data-search="<%= (fb.subject + ' ' + (fb.teacher || '') + ' ' + (fb.batch || '') + ' ' + fb.student_name + ' ' + fb.student_email + ' ' + (fb.roll_number || '') + ' ' + fb.category).toLowerCase() %>">
              <div class="fc-top">
                <div class="student-info-header">
                  <div class="student-avatar-pill">
                    <%= fb.student_name.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <h3 class="fb-subject-title">📖 <%= fb.subject %></h3>
                    <div class="meta">
                      <strong>👤 <%= fb.student_name %></strong>
                      <span class="muted">(<%= fb.student_email %>)</span>
                      <% if (fb.roll_number) { %>
                        &nbsp;•&nbsp;<span class="roll-tag">Roll: <%= fb.roll_number %></span>
                      <% } %>
                    </div>
                    <div class="meta-pills" style="margin-top:6px;">
                      <span class="meta-tag">👨‍🏫 <%= fb.teacher || 'General Faculty' %></span>
                      <span class="meta-tag">👥 <%= fb.batch || 'Batch 2023-2027' %></span>
                      <span class="badge badge-category"><%= fb.category %></span>
                      <span class="stars-display"><%= '★'.repeat(fb.rating) + '☆'.repeat(5 - fb.rating) %></span>
                      <span class="meta-date">📅 <%= new Date(fb.created_at).toLocaleDateString() %></span>
                    </div>
                  </div>
                </div>
                <span class="badge badge-<%= fb.status.toLowerCase() %>"><%= fb.status %></span>
              </div>

              <div class="feedback-body-text">
                <p>"<%= fb.message %>"</p>
              </div>

              <!-- Inline Admin Review Form — Accept / Reject -->
              <form action="/admin/feedback/<%= fb.id %>/status?_method=PUT" method="POST" class="admin-review-form">
                <div class="remark-input-group">
                  <span class="remark-label">Admin Remark:</span>
                  <input type="text" name="admin_remark" placeholder="Write official response or remark for student..." value="<%= fb.admin_remark || '' %>" class="remark-input" />
                </div>
                <div class="action-btn-group">
                  <button type="submit" name="status" value="Accepted" class="btn btn-success btn-sm">✔ Approve</button>
                  <button type="submit" name="status" value="Rejected" class="btn btn-danger btn-sm">✘ Reject</button>
                  <button type="submit" name="status" value="Pending" class="btn btn-outline btn-sm">↺ Reset</button>
                </div>
              </form>

              <div class="card-bottom-actions">
                <form action="/admin/feedback/<%= fb.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Permanently delete this feedback item?');">
                  <button type="submit" class="btn btn-outline-danger btn-xs">🗑 Delete Feedback</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

  <script>
    const adminStatusData = <%- JSON.stringify(statusStats) %>;
    const adminCategoryData = <%- JSON.stringify(categoryStats) %>;
    const chartOptions = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { labels: { usePointStyle: true, font: { family: 'Plus Jakarta Sans' } } } }
    };

    const statusChart = new Chart(document.getElementById('adminStatusChart'), {
      type: 'doughnut',
      data: {
        labels: adminStatusData.map(item => item.label),
        datasets: [{ data: adminStatusData.map(item => item.value), backgroundColor: ['#f59e0b', '#10b981', '#ef4444'], borderWidth: 0, hoverOffset: 8 }]
      },
      options: { ...chartOptions, cutout: '68%' }
    });

    const categoryChart = new Chart(document.getElementById('adminCategoryChart'), {
      type: 'bar',
      data: {
        labels: adminCategoryData.map(item => item.label),
        datasets: [{ label: 'Submissions', data: adminCategoryData.map(item => item.value), backgroundColor: '#6366f1', borderRadius: 8, maxBarThickness: 34 }]
      },
      options: { ...chartOptions, indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { precision: 0 } }, y: { grid: { display: false } } } }
    });

    function updateChartTextContrast(dark) {
      const textColor = dark ? '#f8fafc' : '#0f172a';
      const gridColor = dark ? '#475569' : '#e2e8f0';

      statusChart.options.plugins.legend.labels.color = textColor;
      categoryChart.options.scales.x.ticks.color = textColor;
      categoryChart.options.scales.x.grid.color = gridColor;
      categoryChart.options.scales.y.ticks.color = textColor;
      categoryChart.update();
      statusChart.update();
    }

    updateChartTextContrast(document.body.classList.contains('dark-mode'));
    document.addEventListener('themechange', (event) => updateChartTextContrast(event.detail.dark));
  </script>

  <!-- STUDENT PERSONAL INFO & FEEDBACK MODAL OVERLAY -->
  <div id="studentModal" class="modal-overlay" onclick="closeModalOnBackdrop(event)">
    <div class="modal-card glass-card">
      <button type="button" class="modal-close-btn" onclick="closeStudentModal()">&times;</button>

      <div id="modalLoading" class="modal-loading-spinner">
        <div class="spinner"></div>
        <p>Fetching student details & feedback history...</p>
      </div>

      <div id="modalContent" style="display: none;">
        <!-- Modal Top Banner: Student Personal Details -->
        <div class="modal-header-banner">
          <div class="modal-avatar-lg" id="mAvatar">S</div>
          <div class="modal-header-info">
            <h2 id="mName">Student Name</h2>
            <p id="mEmail" class="m-email">student@college.com</p>
            <div class="modal-pills">
              <span class="modal-pill" id="mRoll">Roll: CS-2023-014</span>
              <span class="modal-pill" id="mCourse">B.Tech Computer Science</span>
              <span class="modal-pill text-green" id="mDate">Joined: Jan 2024</span>
            </div>
          </div>
        </div>

        <!-- Student Summary KPI Cards inside modal -->
        <div class="modal-stats-grid">
          <div class="m-stat-card">
            <small>Total Submitted</small>
            <strong id="mTotal">0</strong>
          </div>
          <div class="m-stat-card text-green">
            <small>Accepted</small>
            <strong id="mAccepted">0</strong>
          </div>
          <div class="m-stat-card text-amber">
            <small>Pending Review</small>
            <strong id="mPending">0</strong>
          </div>
          <div class="m-stat-card text-red">
            <small>Rejected</small>
            <strong id="mRejected">0</strong>
          </div>
          <div class="m-stat-card text-purple">
            <small>Average Rating</small>
            <strong id="mAvgRating">0.0 ★</strong>
          </div>
        </div>

        <!-- Student Feedback History Section -->
        <div class="modal-feedback-section">
          <h3>💬 Feedback History Submitted by <span id="mNameShort">Student</span></h3>
          
          <div id="mFeedbackContainer" class="modal-feedback-list">
            <!-- Dynamic feedback cards injected here via JS -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function filterStudentDirectory() {
      const query = document.getElementById('studentSearchInput').value.toLowerCase();
      const rows = document.querySelectorAll('.student-row');
      rows.forEach(row => {
        const text = row.getAttribute('data-search');
        if (text.includes(query)) {
          row.style.display = 'table-row';
        } else {
          row.style.display = 'none';
        }
      });
    }

    function filterAdminFeedback() {
      const query = document.getElementById('adminSearchInput').value.toLowerCase();
      const cards = document.querySelectorAll('.admin-fb-card');
      cards.forEach(card => {
        const searchData = card.getAttribute('data-search');
        if (searchData.includes(query)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function applyCategoryFilter(cat) {
      const currentUrl = new URL(window.location.href);
      currentUrl.searchParams.set('category', cat);
      window.location.href = currentUrl.toString();
    }

    // Modal Control Functions
    function openStudentModal(studentId) {
      const modal = document.getElementById('studentModal');
      const loading = document.getElementById('modalLoading');
      const content = document.getElementById('modalContent');

      modal.classList.add('active');
      loading.style.display = 'block';
      content.style.display = 'none';

      fetch(`/admin/students/${studentId}/json`)
        .then(res => res.json())
        .then(data => {
          if (data.error) {
            alert(data.error);
            closeStudentModal();
            return;
          }

          const student = data.student;
          const stats = data.stats;
          const feedbacks = data.feedbacks;

          document.getElementById('mAvatar').textContent = student.name.charAt(0).toUpperCase();
          document.getElementById('mName').textContent = student.name;
          document.getElementById('mNameShort').textContent = student.name.split(' ')[0];
          document.getElementById('mEmail').textContent = student.email;
          document.getElementById('mRoll').textContent = `Roll No: ${student.roll_number || 'N/A'}`;
          document.getElementById('mCourse').textContent = student.course || 'Course Not Specified';
          document.getElementById('mDate').textContent = `Joined: ${new Date(student.created_at).toLocaleDateString()}`;

          document.getElementById('mTotal').textContent = stats.total;
          document.getElementById('mAccepted').textContent = stats.accepted;
          document.getElementById('mPending').textContent = stats.pending;
          document.getElementById('mRejected').textContent = stats.rejected;
          document.getElementById('mAvgRating').textContent = `${stats.avgRating} ★`;

          const fbContainer = document.getElementById('mFeedbackContainer');
          fbContainer.innerHTML = '';

          if (feedbacks.length === 0) {
            fbContainer.innerHTML = `
              <div class="empty-state">
                <p>This student has not submitted any feedback yet.</p>
              </div>
            `;
          } else {
            feedbacks.forEach(fb => {
              const starsHtml = '★'.repeat(fb.rating) + '☆'.repeat(5 - fb.rating);
              const card = document.createElement('div');
              card.className = 'feedback-card m-fb-card';
              card.innerHTML = `
                <div class="fc-top">
                  <div>
                    <h4>${escapeHtml(fb.subject)}</h4>
                    <div class="meta">
                      <span class="meta-tag">👨‍🏫 ${escapeHtml(fb.teacher || 'General')}</span>
                      <span class="badge badge-category">${escapeHtml(fb.category)}</span>
                      <span class="stars">${starsHtml}</span>
                      <span>📅 ${new Date(fb.created_at).toLocaleDateString()}</span>
                    </div>
                  </div>
                  <span class="badge badge-${fb.status.toLowerCase()}">${fb.status}</span>
                </div>

                <p class="message">"${escapeHtml(fb.message)}"</p>

                ${fb.admin_remark ? `<div class="remark-box remark-${fb.status.toLowerCase()}" style="margin-top:8px;"><strong>Admin Remark:</strong> ${escapeHtml(fb.admin_remark)}</div>` : ''}

                <form action="/admin/feedback/${fb.id}/status?_method=PUT" method="POST" class="admin-review-form">
                  <div class="remark-input-group">
                    <span class="remark-label">Admin Remark:</span>
                    <input type="text" name="admin_remark" placeholder="Write remark for student..." value="${escapeHtml(fb.admin_remark || '')}" class="remark-input" />
                  </div>
                  <div class="action-btn-group">
                    <button type="submit" name="status" value="Accepted" class="btn btn-success btn-sm">✔ Accept</button>
                    <button type="submit" name="status" value="Rejected" class="btn btn-danger btn-sm">✘ Reject</button>
                    <button type="submit" name="status" value="Pending" class="btn btn-outline btn-sm">↺ Pending</button>
                  </div>
                </form>
              `;
              fbContainer.appendChild(card);
            });
          }

          loading.style.display = 'none';
          content.style.display = 'block';
        })
        .catch(err => {
          console.error(err);
          alert('Failed to load student details.');
          closeStudentModal();
        });
    }

    function closeStudentModal() {
      document.getElementById('studentModal').classList.remove('active');
    }

    function closeModalOnBackdrop(e) {
      if (e.target.id === 'studentModal') {
        closeStudentModal();
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
  </script>
</body>
</html>
